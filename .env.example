# VirtuWill — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Flask ────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

FLASK_DEBUG=true

# ── Database (required) ───────────────────────────────────────────────────────
# On Databricks these come from the attached Lakebase database resource.
# For development, point them at any local PostgreSQL database.
PGHOST=localhost
PGDATABASE=virtuwill
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable
APP_TIMEZONE=America/Chicago

# ── Auth ─────────────────────────────────────────────────────────────────────
JOURNAL_PASSWORD=virtuwill2026

# ── Garden admin ──────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=virtuwill2026

# ── Anthropic OCR (optional) ─────────────────────────────────────────────────
# Required only if you use the "Upload Photo" → Claude Vision OCR feature.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
